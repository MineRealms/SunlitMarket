net.minecraft.server.MinecraftServer server = net.minecraftforge.server.ServerLifecycleHooks.getCurrentServer();
if (server == null) return "NO_SERVER";
((java.util.concurrent.Executor) server).execute(() -> {
    try {
        com.google.gson.JsonObject result = new com.google.gson.JsonObject();
        var merchants = com.society.sunlitmarket.market.MarketRegistry.all();
        result.addProperty("merchants", merchants.size());
        result.addProperty("stagingOpen", com.society.sunlitmarket.market.MarketRegistry.stagingOpen());
        result.addProperty("kubejsErrors", dev.latvian.mods.kubejs.script.ScriptType.SERVER.console.errors.size());
        com.google.gson.JsonArray panels = new com.google.gson.JsonArray();
        for (var panel : com.google.gson.JsonParser.parseString(new com.society.sunlithud.kjs.SunlitHudBinding().json()).getAsJsonArray())
            panels.add(panel.getAsJsonObject().get("id").getAsString());
        result.add("hudPanels", panels);
        result.addProperty("leekMultiplier", com.society.sunlitmarket.market.PriceModifiers.get("me_shire_farmer", "me:leek"));
        net.minecraft.server.level.ServerLevel level = null;
        for (java.lang.reflect.Method method : server.getClass().getMethods()) {
            if (method.getParameterCount() == 0 && method.getReturnType() == net.minecraft.server.level.ServerLevel.class) {
                level = (net.minecraft.server.level.ServerLevel) method.invoke(server);
                break;
            }
        }
        if (level == null) throw new IllegalStateException("No overworld accessor");
        var type = net.minecraftforge.registries.ForgeRegistries.ENTITY_TYPES.getValue(new net.minecraft.resources.ResourceLocation("minecraft:wandering_trader"));
        net.minecraft.world.entity.Entity npc = null;
        for (java.lang.reflect.Method method : type.getClass().getMethods()) {
            if (method.getParameterCount() == 1 && method.getParameterTypes()[0] == net.minecraft.world.level.Level.class
                    && net.minecraft.world.entity.Entity.class.isAssignableFrom(method.getReturnType())) {
                npc = (net.minecraft.world.entity.Entity) method.invoke(type, level);
                break;
            }
        }
        if (npc == null) throw new IllegalStateException("Cannot create detached test entity");
        java.util.Set<String> tags = null;
        String tagsMethod = "";
        for (java.lang.reflect.Method method : npc.getClass().getMethods()) {
            if (method.getParameterCount() == 0 && method.getReturnType() == java.util.Set.class
                    && method.getGenericReturnType().getTypeName().equals("java.util.Set<java.lang.String>")) {
                tags = (java.util.Set<String>) method.invoke(npc);
                tagsMethod = method.getName();
                break;
            }
        }
        if (tags == null) throw new IllegalStateException("No entity tag accessor");
        int checked = 0;
        com.google.gson.JsonArray roles = new com.google.gson.JsonArray();
        for (var merchant : merchants) {
            if (!merchant.id.startsWith("me_") && !merchant.id.startsWith("theme_")) continue;
            if (!merchant.npcType.isBlank()) throw new IllegalStateException("Implicit type merchant " + merchant.id);
            tags.add(merchant.tag);
            var resolved = com.society.sunlitmarket.market.MarketRegistry.resolve(npc);
            var identity = com.society.sunlitmarket.core.MarketRules.identity(npc);
            if (resolved != merchant || identity.customer() || !identity.rank().equals("MERCHANT")
                    || !identity.faction().equals(merchant.faction)) throw new IllegalStateException("Role overlap " + merchant.id + ": " + identity
                        + " tagsMethod=" + tagsMethod + " tags=" + tags + " resolved=" + (resolved == null ? null : resolved.id));
            roles.add(merchant.id + ":" + identity.rank());
            tags.remove(merchant.tag);
            if (com.society.sunlitmarket.market.MarketRegistry.resolve(npc) != null
                    || !com.society.sunlitmarket.core.MarketRules.identity(npc).customer())
                throw new IllegalStateException("Natural customer not restored " + merchant.id);
            checked++;
        }
        result.addProperty("roleChecks", checked);
        result.add("roles", roles);
        var quests = dev.ftb.mods.ftbquests.quest.ServerQuestFile.INSTANCE;
        if (quests == null) throw new IllegalStateException("No server quest file");
        String[][] milestones = {
            {"7C14C2BAC46CE906", "theme.tinkers.adept"},
            {"3E981A3FFE0ADA0D", "theme.thaumcraft.adept"},
            {"28626DC2C0B74311", "theme.astral.attuned"},
            {"46F86152B5B36A3B", "theme.botania.adept"}
        };
        com.google.gson.JsonArray unlocks = new com.google.gson.JsonArray();
        for (String[] milestone : milestones) {
            var quest = quests.getQuest(Long.parseUnsignedLong(milestone[0], 16));
            if (quest == null) throw new IllegalStateException("Missing quest " + milestone[0]);
            int matches = 0;
            for (var reward : quest.getRewards()) {
                if (!(reward instanceof dev.ftb.mods.ftbquests.quest.reward.CommandReward)) continue;
                var tag = new net.minecraft.nbt.CompoundTag();
                reward.writeData(tag);
                String data = tag.toString();
                if (!data.contains("sunlitmarket unlock " + milestone[1])) continue;
                if (!data.contains("execute as {p} run sunlitmarket unlock " + milestone[1])
                        || !data.contains("elevate_perms:1b") || reward.isTeamReward()
                        || reward.getAutoClaimType() != dev.ftb.mods.ftbquests.quest.reward.RewardAutoClaim.NO_TOAST)
                    throw new IllegalStateException("Unsafe unlock reward " + data);
                matches++;
            }
            if (matches != 1) throw new IllegalStateException("Unlock reward count " + milestone[1] + ": " + matches);
            unlocks.add(milestone[0] + ":" + milestone[1]);
        }
        result.add("questUnlocks", unlocks);
        result.addProperty("detachedEntityOnly", true);
        com.society.sunlitmarket.SunlitMarketMod.LOG.info("[SM-INTEGRATION-PROBE] {}", result);
    } catch (Throwable error) {
        com.society.sunlitmarket.SunlitMarketMod.LOG.error("[SM-INTEGRATION-PROBE] FAIL", error);
    }
});
return "Probe scheduled; test entity is never added to the world";
